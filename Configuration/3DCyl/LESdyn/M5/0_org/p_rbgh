FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      p_rbgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0; 

boundaryField
{
    cylinder
    {
        type            fixedFluxPressure;
        gradient        $internalField;
    }
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform  0;
    }
    outletb
    {
        type            fixedFluxPressure;
        gradient        $internalField;
    }
    pit
    {
        type            fixedFluxPressure;
        gradient        $internalField;
    }
    lateral
    {
        type            cyclic;
    }
    symplane
    {
        type            cyclic;
    }
    bottom
    {
        type            fixedFluxPressure;
        gradient        $internalField;
    }
    surface
    {
        type            zeroGradient;
    }
}


