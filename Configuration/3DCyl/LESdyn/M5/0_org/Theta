FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Theta;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-6; 

boundaryField
{
    cylinder
    {
        type            zeroGradient;//fixedValue;
	//value		uniform 1e-5;
    }
    inlet
    {
        type            groovyBC;
        refValue        uniform 0;
        value           uniform 1e-10; //1e-6
        refGradient     uniform 0;
        valueFraction   uniform 1;
        valueExpression "inletprofiletheta(pos().z)";
        gradientExpression "0";
        fractionExpression "1";
        evaluateDuringConstruction 1;
        variables       "";
        timelines       (
);
        lookuptables    (
{
        name            inletprofiletheta;
        file            "$FOAM_CASE/1d_profil/Theta.xy";
        outOfBounds     clamp;
}
);
    }
    pit
    {
        type            zeroGradient;//fixedValue;
	//value		uniform 1e-15;
    }
    outlet
    {
        type            zeroGradient;//inletOutlet;
	//inletValue	uniform 1e-15;
	//value		uniform 1e-15;
    }
    outletb
    {
        type            zeroGradient;//fixedValue;
	//value		uniform 1e-6;
    }
    lateral
    {
        type            cyclic;
    }
    symplane
    {
        type            cyclic;
    }
    bottom
    {
        type            zeroGradient;//fixedValue;
	//value		uniform 1e-6;
    }
    surface
    {
        type           	zeroGradient;//fixedValue;
	//value		uniform 1e-15;
    }
}


