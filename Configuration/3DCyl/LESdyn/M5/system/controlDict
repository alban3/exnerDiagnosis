FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         120;

deltaT          1e-4;

writeControl    adjustableRunTime;

writeInterval   0.25;

purgeWrite      0;

writeFormat     binary;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   7;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1e-4;

favreAveraging false;

libs (
"libturbulenceModels.so"
"libgroovyBC.so"
"libgroovyStandardBCs.so"
"libtwoPhaseTurbulenceModels.so"
     );

functions 
{  
    #include "forceCoeffs"
    Grad
    {
    type            grad;
    libs            (fieldFunctionObjects);
    field           p_rbgh;
    result          gradP_rbgh;
    executeControl  timeStep;
    writeControl    writeTime;
    }
    Multiply
    {
    type            multiply;
    libs            (fieldFunctionObjects);
    fields          (alpha.a U.a);
    result          alphaUa;
    executeControl  timeStep;
    writeControl    writeTime;
    }
    fieldAverage
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        restartOnrestart false;
	periodicRestart     true;
    	restartPeriod       0.25;
        fields
        (
            U.b
            {
               mean         on;
               prime2Mean   on;
               base         time;
            }
	    U.a
            {
               mean         on;
               prime2Mean   on;
               base         time;
            }
	    alpha.a
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
            p_rbgh
            {
                mean        on;
                prime2Mean  on;
                base        time;
            }
            gradP_rbgh
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
	    alphaUa
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
        );
    }
}

OptimisationSwitches
{
    //- Parallel IO file handler
    //  uncollated (default), collated or masterUncollated
    fileHandler collated;
}

