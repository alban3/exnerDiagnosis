PIMPLE
{
    nCorrectors     2;
    nOuterCorrectors 1;
    nNonOrthogonalCorrectors 1;
    nAlphaCorr      1;
    correctAlpha    no;
    //pRefPoint       (0.001 0.001 0.0001);
    pRefCell        1001;
    pRefValue       0;
    faceMomentum    true;
}

